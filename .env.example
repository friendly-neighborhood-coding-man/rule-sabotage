# Copy to .env (never commit .env). Everything is optional: without it the game runs
# with the offline parser + local planner, clearly labelled in the UI.

# --- OpenRouter (rule interpretation + AI opponent). Key stays server-side. ---
OPENROUTER_API_KEY=
# Any model that is free on https://openrouter.ai/models?max_price=0 . Default: openrouter/free
OPENROUTER_MODEL=

# --- Kane referee ---
# on (default): every new rule is simulated, then judged by the real kane-cli before it goes live.
# off: engine checks only (rules are labelled "NOT Kane-verified").
KANE_REFEREE=on
# Path/command for kane-cli (default: kane-cli on PATH)
KANE_CLI=
# analyzer (default: kane-cli run --analyzer-only on the trial page) | objective (kane-cli run "<objective>" --url)
KANE_MODE=analyzer
KANE_TIMEOUT_S=300
# Chrome/Edge used to open the trial page for Kane (auto-detected on Windows/macOS/Linux)
KANE_CHROME=
# 1 = let rules Kane could not verify go live anyway (labelled). Default: they do not.
ALLOW_UNVERIFIED_RULES=

PORT=3000
