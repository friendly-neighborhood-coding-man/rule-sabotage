{
  "skillflow": 1,
  "name": "GameWatch GW2: blind rule discovery with external deterministic verification",
  "start": "procedures",
  "limits": { "max_steps": 20, "max_backtracks": 0 },
  "tasks": [
    { "id": "procedures", "title": "Collector: verify the frozen generation procedure, partition procedure and bundle provenance", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "procedures", "{out}/01-procedures.json", "{exp}", "--generation", "{generation}", "--partition", "{partition}", "--bundle", "{bundle}"],
      "produces": ["{out}/01-procedures.json"], "accept": [{ "json": "{out}/01-procedures.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "partition", "fail": "@stop" } },
    { "id": "partition", "title": "Collector: partition (frozen procedure) and leak-check the served discovery site", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "partition", "{out}/02-partition.json", "{exp}", "--partition", "{partition}", "--bundle", "{bundle}"],
      "produces": ["{out}/02-partition.json"], "accept": [{ "json": "{out}/02-partition.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "session-plan", "fail": "@stop" } },
    { "id": "session-plan", "title": "Collector: declare the session plan before any session", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "session-plan", "{out}/03-session-plan.json", "{exp}", "--sessions", "{sessions}", "--profiles", "{profiles}"],
      "produces": ["{out}/03-session-plan.json"], "accept": [{ "json": "{out}/03-session-plan.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "investigate", "fail": "@stop" } },
    { "id": "investigate", "title": "Investigator: blind discovery sessions through the Kane CLI boundary (review server, access journal, submissions, closure)", "skill": "skills/investigator.md",
      "authorization": "kane-paid", "timeout_s": 9000,
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/kane-boundary.ts", "{exp}", "--route", "{route}", "--profiles", "{profiles}"],
      "next": { "exit:0": "closure", "exit:2": "@stop", "exit:3": "@stop", "fail": "@stop", "pass": "closure" } },
    { "id": "closure", "title": "Verifier: every session closed and sealed", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "closure", "{out}/05-closure.json", "{exp}"],
      "produces": ["{out}/05-closure.json"], "accept": [{ "json": "{out}/05-closure.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "import", "fail": "@stop" } },
    { "id": "import", "title": "Verifier: explicit import of every closed session", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "import", "{out}/06-import.json", "{exp}"],
      "produces": ["{out}/06-import.json"], "accept": [{ "json": "{out}/06-import.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "freeze", "fail": "@stop" } },
    { "id": "freeze", "title": "Verifier: experiment-level hypothesis freeze", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "freeze", "{out}/07-freeze.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/07-freeze.json"], "accept": [{ "json": "{out}/07-freeze.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "representations", "fail": "@stop" } },
    { "id": "representations", "title": "Verifier: submitter representations extracted verbatim and sealed before evaluation", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "representations", "{out}/08-representations.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/08-representations.json"], "accept": [{ "json": "{out}/08-representations.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "three-way", "fail": "@stop" } },
    { "id": "three-way", "title": "Verifier: three-way verification through the gate", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "three-way", "{out}/09-three-way.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/09-three-way.json"], "accept": [{ "json": "{out}/09-three-way.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "heldout", "fail": "@stop" } },
    { "id": "heldout", "title": "Verifier: held-out prediction through the gate", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "heldout", "{out}/10-heldout.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/10-heldout.json"], "accept": [{ "json": "{out}/10-heldout.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "discriminate", "fail": "@stop" } },
    { "id": "discriminate", "title": "Verifier: competing-hypothesis discrimination through the gate", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "discriminate", "{out}/11-discriminate.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/11-discriminate.json"], "accept": [{ "json": "{out}/11-discriminate.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "report", "fail": "@stop" } },
    { "id": "report", "title": "Verifier: separated per-investigator report (abstention handling checked)", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "report", "{out}/12-report.json", "{exp}", "--at", "{at}"],
      "produces": ["{out}/12-report.json"], "accept": [{ "json": "{out}/12-report.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "integrity", "fail": "@stop" } },
    { "id": "integrity", "title": "Verifier: integrity of every sealed artifact", "skill": "skills/verifier.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/gw2/p6-steps.ts", "integrity", "{out}/13-integrity.json", "{exp}"],
      "produces": ["{out}/13-integrity.json"], "accept": [{ "json": "{out}/13-integrity.json", "path": "ok", "op": "==", "value": true }],
      "next": { "pass": "@done", "fail": "@stop" } }
  ]
}
