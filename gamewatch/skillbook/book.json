{
  "skillflow": 1,
  "name": "GameWatch: Kane-powered game QA (Rule Sabotage integration)",
  "start": "collect-discover",
  "limits": { "max_steps": 30, "max_backtracks": 2 },
  "tasks": [
    { "id": "collect-discover", "title": "Collector: discover rules and existing playtest infrastructure", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/discover.ts", "{out}/discovery.json"],
      "produces": ["{out}/discovery.json"], "accept": [{ "json": "{out}/discovery.json", "path": "rules", "op": "!=", "value": [] }],
      "next": { "pass": "collect-evidence", "fail": "@stop" } },
    { "id": "collect-evidence", "title": "Collector: collect real gameplay evidence (scripted + matched AI games)", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/run-evidence.ts", "all", "--keep-existing"], "timeout_s": 3600, "retries": 1,
      "produces": ["evidence/gamewatch/evidence.json"],
      "accept": [{ "json": "evidence/gamewatch/evidence.json", "path": "schema", "op": "==", "value": "gamewatch/evidence@1" }],
      "next": { "pass": "collect-gaps", "fail": "@stop" } },
    { "id": "collect-gaps", "title": "Collector: identify missing evidence", "skill": "skills/collector.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/gaps.ts", "evidence/gamewatch/evidence.json", "gamewatch/adapters/rule-sabotage.coverage.json", "{out}/gaps.json"],
      "produces": ["{out}/gaps.json"], "next": { "exit:0": "port-pages", "exit:10": "collect-gap-fill", "fail": "@stop", "pass": "port-pages" } },
    { "id": "collect-gap-fill", "title": "Collector: write scripted playtests for the gaps (coding agent)", "skill": "skills/collector.md", "authorization": "coding-agent",
      "requires": ["{out}/gaps.json"], "run": ["claude", "-p", "Read {context} and {out}/gaps.json. Add scripted playtests to gamewatch/scenarios.ts that exercise each missing rule. Do not change the game."],
      "next": { "pass": "collect-evidence", "fail": "@stop" } },
    { "id": "port-pages", "title": "Porter: build the anonymous evidence pages", "skill": "skills/porter.md",
      "requires": ["evidence/gamewatch/evidence.json"],
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/dashboard.ts"], "produces": ["evidence/gamewatch/site/index.html", "evidence/gamewatch/site/report.html"],
      "next": { "pass": "port-leakcheck", "fail": "@stop" } },
    { "id": "port-leakcheck", "title": "Porter: check the pages carry no expected answers", "skill": "skills/porter.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/leakcheck.ts", "evidence/gamewatch/site", "{out}/porter.json"],
      "produces": ["{out}/porter.json"], "next": { "pass": "port-kane-plan", "fail": "@stop" } },
    { "id": "port-kane-plan", "title": "Porter: prepare the Kane call (verified invocation, frozen inputs, dry run)", "skill": "skills/porter.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/kane/run.ts"],
      "next": { "pass": "analyze-balance", "fail": "@stop" } },
    { "id": "analyze-balance", "title": "Analyzer: balance analysis (engine statistics)", "skill": "skills/analyzer.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/balance.ts", "evidence/gamewatch/evidence.json", "{out}/balance.json"],
      "produces": ["{out}/balance.json"], "next": { "pass": "analyze-kane-review", "fail": "@stop" } },
    { "id": "analyze-kane-review", "title": "Analyzer: blind Kane bug discovery (ONE paid objective-mode call)", "skill": "skills/analyzer.md", "spec": "specs/kane-review.md",
      "authorization": "kane-paid",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/kane/run.ts", "--execute"], "timeout_s": 3300,
      "next": { "exit:0": "analyze-coverage", "exit:2": "@stop", "exit:3": "report", "pass": "analyze-coverage", "fail": "@stop" } },
    { "id": "analyze-coverage", "title": "Analyzer: coverage audit of Kane's review", "skill": "skills/analyzer.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/audit.ts", "evidence/gamewatch/evidence.json", "evidence/gamewatch/review/notes.ndjson", "kane", "{out}/audit.json"],
      "produces": ["{out}/audit.json"], "next": { "exit:0": "analyze-fix", "exit:3": "report", "pass": "analyze-fix", "fail": "report" } },
    { "id": "analyze-fix", "title": "Analyzer: coding agent reproduces and fixes the findings (blind workspace)", "skill": "skills/analyzer.md", "spec": "specs/closed-loop.md",
      "authorization": "coding-agent", "timeout_s": 3600,
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/fix.ts", "{build}", "{workspace}", "evidence/gamewatch/review/notes.ndjson"],
      "produces": ["{workspace}/CLOSED_LOOP_REPORT.md"], "next": { "pass": "analyze-regression-evidence", "fail": "report" } },
    { "id": "analyze-regression-evidence", "title": "Analyzer: re-run the same playtests on the corrected build", "skill": "skills/analyzer.md", "timeout_s": 3600,
      "run": ["node", "--experimental-strip-types", "--no-warnings", "{workspace}/gamewatch/run-evidence.ts", "all"],
      "produces": ["{workspace}/evidence/gamewatch/evidence.json"], "next": { "pass": "analyze-regression", "fail": "report" } },
    { "id": "analyze-regression", "title": "Analyzer: regression review against the reference build", "skill": "skills/analyzer.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/regression.ts", "evidence/gamewatch/evidence.json", "{reference}", "evidence/gamewatch/evidence.json", "{build}", "{workspace}/evidence/gamewatch/evidence.json", "under-test", "{out}/regression.json"],
      "produces": ["{out}/regression.json"], "next": { "exit:0": "report", "exit:10": "analyze-fix", "fail": "report", "pass": "report" } },
    { "id": "report", "title": "Analyzer: actionable QA report", "skill": "skills/analyzer.md",
      "run": ["node", "--experimental-strip-types", "--no-warnings", "gamewatch/skillbook/steps/report.ts", "{out}", "evidence/gamewatch/review/notes.ndjson"],
      "produces": ["{out}/QA_REPORT.md"], "next": { "pass": "@done" } }
  ]
}
